{
	"name": "character-backend",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write .",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:debug": "vitest --inspect-brk --no-file-parallelism",
		"test:e2e": "vitest run --config ./vitest.config.e2e.ts",
		"lint:fix": "eslint . --fix",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"check": "npm run lint && npm run format:check && npm run typecheck",
		"ci": "npm run check && npm test && npm run test:e2e && npm run build",
		"migration:create": "typeorm migration:create",
		"migration:generate": "npm run build && typeorm migration:generate -d dist/data-source.js",
		"postmigration:generate": "eslint --fix src/migrations && prettier --write src/migrations",
		"migration:run": "npm run build && typeorm migration:run -d dist/data-source.js",
		"migration:revert": "npm run build && typeorm migration:revert -d dist/data-source.js",
		"migration:show": "npm run build && typeorm migration:show -d dist/data-source.js"
	},
	"dependencies": {
		"@nestjs/common": "^12.0.1",
		"@nestjs/config": "^12.1.1",
		"@nestjs/core": "^12.0.1",
		"@nestjs/platform-express": "^12.0.1",
		"@nestjs/typeorm": "^12.0.3",
		"better-sqlite3": "^12.11.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"typeorm": "^1.1.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@nestjs/cli": "^12.0.0",
		"@nestjs/schematics": "^12.0.0",
		"@nestjs/testing": "^12.0.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/express": "^5.0.0",
		"@types/node": "^24.0.0",
		"@types/supertest": "^7.0.0",
		"@vitest/coverage-v8": "^4.1.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.0.0",
		"vitest": "^4.1.2"
	},
	"engines": {
		"node": "24.x"
	}
}
