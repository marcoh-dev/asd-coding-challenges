{
	"name": "rick-and-morty-gallery",
	"version": "1.0.0",
	"main": "src/index.ts",
	"dependencies": {
		"expo": "~58.0.23",
		"expo-image": "~58.0.18",
		"expo-splash-screen": "~58.0.13",
		"expo-status-bar": "~58.0.4",
		"lucide-react-native": "^1.69.0",
		"react": "19.3.0",
		"react-native": "0.88.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-svg": "15.16.0"
	},
	"devDependencies": {
		"@types/react": "~19.3.0",
		"eslint": "^9.39.5",
		"eslint-config-expo": "~58.0.4",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3"
	},
	"scripts": {
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"lint": "expo lint",
		"lint:fix": "expo lint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"check": "npm run lint && npm run format:check && npm run typecheck"
