	"main": "expo-router/entry",
	"dependencies": {
		"@hookform/resolvers": "^7.0.5",
		"@tanstack/react-query": "^5.107.1",
		"expo": "~58.0.23",
		"expo-constants": "~58.0.15",
		"expo-image": "~58.0.18",
		"expo-linking": "~58.0.16",
		"expo-network": "~58.0.4",
		"expo-router": "~58.0.30",
		"expo-splash-screen": "~58.0.13",
		"expo-sqlite": "~58.0.15",
		"expo-status-bar": "~58.0.4",
		"expo-system-ui": "~58.0.7",
		"lucide-react-native": "^1.70.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-hook-form": "^7.91.0",
		"react-native": "0.88.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-svg": "15.16.0",
		"zod": "^4.6.7",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@types/react": "~19.3.0",
		"eslint": "^9.39.5",
		"eslint-config-expo": "~58.0.4",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3"
	},
	"scripts": {
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"lint": "expo lint",
		"lint:fix": "expo lint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "expo customize tsconfig.json && tsc --noEmit",
		"check": "pnpm lint && pnpm format:check && pnpm typecheck",
		"expo-doctor": "npm_config_force=true pnpm dlx expo-doctor"
	},
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@12.18.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.18.0",
			"onFail": "download"
		}
	}
}
