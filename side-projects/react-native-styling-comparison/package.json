{
	"name": "react-native-styling-comparison",
	"version": "1.0.0",
	"main": "expo-router/entry",
	"dependencies": {
		"@tanstack/react-query": "^5.107.1",
		"expo": "~58.0.23",
		"expo-constants": "~58.0.15",
		"expo-image": "~58.0.18",
		"expo-linking": "~58.0.16",
		"expo-router": "~58.0.30",
		"expo-splash-screen": "~58.0.13",
		"expo-status-bar": "~58.0.4",
		"expo-system-ui": "~58.0.7",
		"lucide-react-native": "^1.70.0",
		"nativewind": "^4.2.7",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.1",
		"react-native-css-interop": "^0.2.7",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-svg": "15.16.0",
		"react-native-worklets": "0.13.0"
	},
	"devDependencies": {
		"@types/react": "~19.3.0",
		"babel-preset-expo": "~58.0.24",
		"eslint": "^9.39.5",
		"eslint-config-expo": "~58.0.4",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.10",
		"tailwindcss": "^3.4.19",
		"typescript": "~6.0.3"
	},
	"scripts": {
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"lint": "expo lint",
		"lint:fix": "expo lint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "expo customize tsconfig.json && tsc --noEmit",
		"check": "pnpm lint && pnpm format:check && pnpm typecheck",
		"expo-doctor": "npm_config_force=true pnpm dlx expo-doctor"
	},
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@12.18.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.18.0",
			"onFail": "download"
		}
	}
}
