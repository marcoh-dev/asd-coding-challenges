{
  "name": "js-structure_spacerocket",
  "version": "0.0.0-unreleased",
  "description": "Static HTML template with CSS and JS",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run --globals --passWithNoTests",
    "start": "vite --port 3000 --open"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "nf": {
    "template": "html-css-js"
  },
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.18.0",
      "onFail": "download"
    }
  }
