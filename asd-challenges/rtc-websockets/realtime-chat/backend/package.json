{
	"name": "backend",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:debug": "vitest --inspect-brk --no-file-parallelism",
		"test:e2e": "vitest run --config ./vitest.config.e2e.ts"
	},
	"dependencies": {
		"@nestjs/common": "^12.4.2",
		"@nestjs/core": "^12.4.2",
		"@nestjs/platform-express": "^12.4.2",
		"@nestjs/platform-socket.io": "^12.4.2",
		"@nestjs/websockets": "^12.4.2",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"socket.io": "^4.8.4"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^9.39.5",
		"@nestjs/cli": "^12.0.12",
		"@nestjs/schematics": "^12.0.13",
		"@nestjs/testing": "^12.4.2",
		"@types/express": "^5.0.6",
		"@types/node": "^24.19.2",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"source-map-support": "^0.5.21",
		"supertest": "^7.3.2",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"vitest": "^5.1.0"
	},
	"packageManager": "pnpm@12.18.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.18.0",
			"onFail": "download"
		}
	}
}
