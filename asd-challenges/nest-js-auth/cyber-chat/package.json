{
	"name": "cyber-chat",
	"private": true,
	"scripts": {
		"build": "nest build",
		"dev": "nest start --watch",
		"start": "nest start",
		"db:seed": "ts-node ./src/db/seed.ts",
		"typeorm": "ts-node ./node_modules/typeorm/cli.js -d ./src/db/data-source.ts",
		"migration:generate": "pnpm typeorm migration:generate",
		"migration:run": "pnpm typeorm migration:run",
		"migration:revert": "pnpm typeorm migration:revert"
	},
	"devDependencies": {
		"@nestjs/cli": "^12.0.12",
		"@nestjs/schematics": "^12.0.13",
		"@types/bcrypt": "^6.0.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24.19.2",
		"@types/passport-jwt": "^4.0.1",
		"@types/passport-local": "^1.0.38",
		"ts-node": "^10.9.2",
		"typescript": "~6.0.3"
	},
	"dependencies": {
		"@nestjs/common": "^12.4.2",
		"@nestjs/config": "^12.1.1",
		"@nestjs/core": "^12.4.2",
		"@nestjs/jwt": "^12.0.4",
		"@nestjs/mapped-types": "^12.0.1",
		"@nestjs/passport": "^12.0.1",
		"@nestjs/platform-express": "^12.4.2",
		"@nestjs/typeorm": "^12.0.3",
		"bcrypt": "^6.0.0",
		"better-sqlite3": "^12.11.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"dotenv": "^18.0.10",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"reflect-metadata": "^0.2.2",
		"typeorm": "^1.1.2"
	},
	"packageManager": "pnpm@12.18.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.18.0",
			"onFail": "download"
		}
	}
}
